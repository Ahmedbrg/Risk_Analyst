# APP CONFIGURATION
APP_NAME="AI Risk Analyst Platform"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=super-secret-key-change-this-in-production-32-chars

# SERVER HOST & PORT
HOST=0.0.0.0
PORT=8000

# OPENROUTER & LLM SETTINGS
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
OPENAI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# VECTOR DATABASE (QDRANT)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=risk_document_chunks

# DATABASE (POSTGRESQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airisk_db

# AUTOMATION (N8N)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/risk-analysis-report
